---
import { skills } from '../data/content';
---

<section id="skills" class="section-alt">
  <div class="container">
    <p class="tag fade">Skills</p>
    <h2 class="section-title fade">Technical Toolkit</h2>
    <div class="skills-grid">
      {
        skills.map((group) => (
          <div class="skill-card fade">
            <div class="skill-card-header">
              <span class="skill-icon" aria-hidden="true">{group.icon}</span>
              <h3>{group.title}</h3>
            </div>
            <div class="skill-chips" style="gap:7px">
              {group.tags.map((t) => <span class="skill-tag">{t}</span>)}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
