---
import { site } from '../data/content';

const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#impact', label: 'Impact' },
];
---

<nav class="nav" id="navbar" aria-label="Primary">
  <div class="nav-inner">
    <a href="#hero" class="nav-logo">{site.initials}<span>.</span></a>

    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#contact" class="nav-cta">Hire Me</a>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle color theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
    </div>

    <div class="nav-mobile-controls">
      <button class="theme-toggle" id="themeToggleMobile" type="button" aria-label="Toggle color theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
      <button class="menu-btn" id="menuBtn" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu">☰</button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    {links.map((l) => <a href={l.href} data-close-menu>{l.label}</a>)}
    <a href="#contact" data-close-menu>Contact</a>
  </div>
</nav>

<style>
  .nav-mobile-controls { display: none; gap: 8px; align-items: center; }
  @media (max-width: 768px) {
    .nav-mobile-controls { display: flex; }
    #themeToggle { display: none; }
  }
</style>
