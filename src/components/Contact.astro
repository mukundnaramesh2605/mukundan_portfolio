---
import { social } from '../data/content';
import { withBase } from '../lib/url';

const strip = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const resumeHref = social.resume ? withBase(social.resume) : '';
---

<section id="contact" class="section" style="border-top:1px solid var(--border)">
  <div class="container">
    <div class="contact-grid">
      <div>
        <p class="tag fade">Contact</p>
        <h2 class="section-title fade" style="margin-bottom:20px">Let's Build Something Together</h2>
        <p class="fade" style="color:var(--text-dim);font-size:16px;line-height:1.8;margin-bottom:40px;max-width:420px">
          Open to quality engineering roles, AI/ML collaborations, and interesting conversations.
          Reach out through any of the channels below.
        </p>
        {
          resumeHref && (
            <a href={resumeHref} download class="btn-download fade">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              Download Resume
            </a>
          )
        }
      </div>

      <div class="contact-links">
        <a href={`mailto:${social.email}`} class="contact-link fade">
          <div class="contact-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
          </div>
          <div><div class="contact-label">Email</div><div class="contact-val">{social.email}</div></div>
          <div class="contact-arrow" aria-hidden="true">→</div>
        </a>

        <a href={social.linkedin} class="contact-link fade" target="_blank" rel="noopener">
          <div class="contact-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"/></svg>
          </div>
          <div><div class="contact-label">LinkedIn</div><div class="contact-val">{strip(social.linkedin)}</div></div>
          <div class="contact-arrow" aria-hidden="true">→</div>
        </a>

        <a href={social.github} class="contact-link fade" target="_blank" rel="noopener">
          <div class="contact-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.1.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.08-.72.08-.72 1.2.08 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.3.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 013-.4c1.02.005 2.04.14 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </div>
          <div><div class="contact-label">GitHub</div><div class="contact-val">{strip(social.github)}</div></div>
          <div class="contact-arrow" aria-hidden="true">→</div>
        </a>
      </div>
    </div>
  </div>
</section>
