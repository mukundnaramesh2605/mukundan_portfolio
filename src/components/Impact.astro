---
import { impact } from '../data/content';
---

<section id="impact" class="section-alt">
  <div class="container">
    <p class="tag fade">Selected Quality Impact</p>
    <h2 class="section-title fade">Work That Moved the Needle</h2>
    <div class="impact-grid">
      {
        impact.map((item) => (
          <article class="impact-card fade">
            <div class="impact-top">
              <span class="impact-icon" aria-hidden="true">{item.icon}</span>
              <span class="impact-metric">{item.metric}</span>
            </div>
            <h3 class="impact-title">{item.title}</h3>
            <p class="impact-desc">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
